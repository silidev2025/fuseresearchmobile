<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Light, NOT DayNight.

         The console declares `color-scheme: only light` and its severity ladder
         was measured against a white ground - CLAUDE.md is explicit that the
         contrast ratios and the colour-vision separations do not survive being
         inverted by a theme. A DayNight parent handed a phone in dark mode a
         dark Activity sitting behind a deliberately light WebView, which shows
         as a dark flash on launch and dark edges around the content.

         The system bars take the console's own surface colour for the same
         reason: the app should not be a white screen in a dark frame. Light
         status-bar icons are needed to stay legible on it - that attribute is
         API 23, which is exactly this app's minSdk. windowLightNavigationBar is
         API 27 and is ignored below that, harmlessly. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/fuseSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/fuseSurface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The launch screen. Same surface and the same bar treatment, so the
         handover from splash to console is not a colour change. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/fuseSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/fuseSurface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
