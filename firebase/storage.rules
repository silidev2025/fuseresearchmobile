rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /frames/{cam}/{file} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /clips/{cam}/{file} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
